{
  "name": "cooked-profile-roaster",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./dist server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/**/*.test.ts",
    "check:connectors": "tsx scripts/check-connectors.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
