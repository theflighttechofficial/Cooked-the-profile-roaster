# Gemini writes the roasts. Without it (or when it fails), Cooked tries Ollama if set,
# then its built-in local roaster. Screenshots fall back to on-device OCR. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: pin a model. Otherwise gemini-flash-latest, then gemini-flash-lite-latest.
GEMINI_MODEL=""

# Optional: GitHub allows 60 requests/hour without a token, 5000 with one.
# Any classic or fine-grained token with no scopes works.
GITHUB_TOKEN=""

# Required for the Last.fm connector. Free: https://www.last.fm/api/account/create
LASTFM_API_KEY=""

# Optional: Reddit blocks most anonymous requests from cloud servers.
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Optional: adds the full Steam library (games owned, never played, total hours).
# Free: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

PORT=3000

# Optional: a local LLM through Ollama, tried when Gemini is missing or fails.
# Only works where this server can reach Ollama (your machine, a Docker host), not on Vercel.
OLLAMA_URL=""
# Default: llama3.2
OLLAMA_MODEL=""
# Optional vision model for screenshot roasts, e.g. llava or llama3.2-vision
OLLAMA_VISION_MODEL=""
# Default: 90000
OLLAMA_TIMEOUT_MS=""
