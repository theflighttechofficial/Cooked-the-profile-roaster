# Gemini writes the roasts and is the only engine that reads screenshots. When it is missing
# or fails, Cooked tries Groq, then Ollama (each if set), then its built-in local roaster.
# Screenshots fall back to on-device OCR. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: another Gemini model. Default: gemini-3.5-flash-lite
GEMINI_MODEL=""

# Optional: GitHub allows 60 requests/hour without a token, 5000 with one.
# Any classic or fine-grained token with no scopes works.
GITHUB_TOKEN=""

# Required for the Last.fm connector. Free: https://www.last.fm/api/account/create
LASTFM_API_KEY=""

# Optional: Reddit blocks most anonymous requests from cloud servers.
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Optional: adds the full Steam library (games owned, never played, total hours).
# Free: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

PORT=3000

# Optional: Groq, text only, tried after Gemini. Free key: https://console.groq.com/keys
GROQ_API_KEY=""
# Default: llama-3.1-8b-instant
GROQ_MODEL=""

# Optional: a local LLM through Ollama, text only, tried after Gemini and Groq.
# Only works where this server can reach Ollama (your machine, a Docker host), not on Vercel.
OLLAMA_URL=""
# Default: llama3.2
OLLAMA_MODEL=""
# Default: 90000
OLLAMA_TIMEOUT_MS=""
